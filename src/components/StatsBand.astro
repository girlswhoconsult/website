---
/* "By the Numbers": the one loud moment on the site. Full-bleed pink-600,
   numbers in white (large text, 3.24:1), captions in ink (5.83:1). */
import Icon from './Icon.astro';
import { statsBlock, formatStat } from '../lib/data';

const spoken = (s: (typeof statsBlock.stats)[number]) =>
  [s.prefix, `${formatStat(s)}${s.suffix ?? ''}`, s.unit].filter(Boolean).join(' ');
---

<section class="numbers bg-pink-600" aria-labelledby="numbers-heading">
  <div class="container-x section">
    <div class="grid gap-5 lg:grid-cols-12 lg:items-end" data-reveal>
      <h2 id="numbers-heading" class="numbers-title text-white lg:col-span-7">{statsBlock.heading}</h2>
      <p class="max-w-[30ch] text-lg font-medium text-ink lg:col-span-5 lg:justify-self-end lg:text-right">
        {statsBlock.intro}
      </p>
    </div>

    <ul class="stats mt-12 lg:mt-16" role="list">
      {
        statsBlock.stats.map((s) => (
          <li class="stat">
            <Icon name={s.icon} size={30} class="text-white" />
            <p class="stat-figure">
              {s.prefix && (
                <span class="stat-affix" aria-hidden="true">
                  {s.prefix}
                </span>
              )}
              <span class="stat-number tabular" aria-hidden="true" data-count-to={s.kind === 'number' ? s.value : undefined}>
                {formatStat(s)}
              </span>
              {s.suffix && (
                <span class="stat-number" aria-hidden="true">
                  {s.suffix}
                </span>
              )}
              {s.unit && (
                <span class="stat-affix" aria-hidden="true">
                  {s.unit}
                </span>
              )}
              <span class="sr-only">{spoken(s)}</span>
            </p>
            <p class="stat-label">{s.label}</p>
            <p class="stat-caption">{s.caption}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .numbers-title {
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  /* A data table, not a card grid: 1px white rules between cells. */
  .stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: rgb(255 255 255 / 0.4);
    border-block: 1px solid rgb(255 255 255 / 0.4);
  }
  .stat {
    background: var(--color-pink-600);
    padding: 2rem 0 2.5rem;
  }
  @media (min-width: 640px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .stat {
      padding: 2rem 1.75rem 2.75rem;
    }
    .stat:nth-child(2n + 1) {
      padding-left: 0;
    }
  }
  @media (min-width: 1024px) {
    .stats {
      grid-template-columns: repeat(3, 1fr);
    }
    .stat {
      padding: 2.25rem 2.5rem 3rem;
    }
    .stat:nth-child(2n + 1) {
      padding-left: 2.5rem;
    }
    .stat:nth-child(3n + 1) {
      padding-left: 0;
    }
  }

  .stat-figure {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 0.4rem;
    margin-top: 1.75rem;
    color: var(--color-white);
    font-weight: 800;
    line-height: 0.88;
  }
  .stat-number {
    font-size: clamp(3.75rem, 7.4vw, 6.5rem);
    letter-spacing: -0.05em;
  }
  .stat-number + .stat-number {
    margin-left: -0.35rem;
  }
  .stat-affix {
    font-size: 1.375rem;
    font-weight: 750;
    letter-spacing: -0.015em;
  }
  .stat-label {
    margin-top: 1rem;
    font-size: 1.25rem;
    font-weight: 750;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--color-white);
  }
  .stat-caption {
    margin-top: 0.375rem;
    max-width: 30ch;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-ink);
  }
</style>
