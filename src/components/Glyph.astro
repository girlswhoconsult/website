---
/* Solid brand shapes from the hero mosaic, reused as small markers so the
   geometry reads as one system. Purely decorative. */
interface Props {
  shape: 'sparkle' | 'quarter' | 'circle' | 'triangle' | 'arch' | 'half' | 'square';
  size?: number;
  class?: string;
}
const { shape, size = 40, class: className } = Astro.props;

const shapes: Record<Props['shape'], string> = {
  sparkle: '<path d="M20 2Q22.2 17.8 38 20Q22.2 22.2 20 38Q17.8 22.2 2 20Q17.8 17.8 20 2Z"/>',
  quarter: '<path d="M40 40H2A38 38 0 0 1 40 2Z"/>',
  circle: '<circle cx="20" cy="20" r="18"/>',
  triangle: '<path d="M20 4 37 36H3Z"/>',
  arch: '<path d="M3 38V20a17 17 0 0 1 34 0v18Z"/>',
  half: '<path d="M10 2a18 18 0 0 1 0 36Z"/>',
  square: '<rect x="5" y="5" width="30" height="30" fill="none" stroke="currentColor" stroke-width="6"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 40 40"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={shapes[shape]}
/>
