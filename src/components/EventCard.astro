---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { eventDateParts, eventWhen, isDraft, isVirtual } from '../lib/data';

interface Props {
  entry: CollectionEntry<'events'>;
  variant?: 'upcoming' | 'past';
  /** Home page teaser: no images. */
  compact?: boolean;
  headingLevel?: 'h3' | 'h4';
}

const { entry, variant = 'upcoming', compact = false, headingLevel: Heading = 'h3' } = Astro.props;
const { data } = entry;
const parts = eventDateParts(data.date);
const virtual = isVirtual(data.location);
const { Content } = await render(entry);
const hasRecap = Boolean(entry.body?.trim());
---

{
  variant === 'upcoming' ? (
    <article class="event grid gap-6 border-t border-line py-8 sm:grid-cols-[auto_minmax(0,1fr)] md:gap-10 lg:grid-cols-[auto_minmax(0,1fr)_auto]">
      <p class="date-tile" aria-hidden="true">
        <span class="date-month">{parts.month}</span>
        <span class="date-day tabular">{parts.day}</span>
      </p>
      <div class="min-w-0">
        {isDraft(entry) && <p class="draft-tag">Draft: hidden on the live site</p>}
        <Heading class="h3">{data.title}</Heading>
        <ul class="mt-3 space-y-1.5 text-[0.9375rem] text-muted" role="list">
          <li class="meta">
            <Icon name="clock" size={18} />
            <span>{eventWhen(data.date, data.endDate)}</span>
          </li>
          <li class="meta">
            <Icon name={virtual ? 'video' : 'pin'} size={18} />
            <span>{virtual ? 'Virtual' : `In person, ${data.location}`}</span>
          </li>
          {data.partner && (
            <li class="meta">
              <Icon name="briefcase" size={18} />
              <span>With {data.partner}</span>
            </li>
          )}
        </ul>
        <p class="mt-4 max-w-[62ch]">{data.description}</p>
        {!compact && data.image && (
          <Image
            src={data.image}
            alt={data.imageAlt ?? ''}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 640px, 100vw"
            class="mt-6 w-full max-w-[40rem] rounded-[4px] border border-line"
          />
        )}
      </div>
      <div class="sm:col-start-2 lg:col-start-auto lg:self-center">
        {data.signupUrl ? (
          <a class="btn btn-primary" href={data.signupUrl} target="_blank" rel="noopener">
            Sign up
            <Icon name="external" size={16} strokeWidth={2} />
            <span class="sr-only">for {data.title} (opens in a new tab)</span>
          </a>
        ) : (
          <p class="text-sm font-semibold text-muted">Sign-up link coming soon</p>
        )}
      </div>
    </article>
  ) : (
    <article class="event grid gap-8 border-t border-line py-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        {isDraft(entry) && <p class="draft-tag">Draft: hidden on the live site</p>}
        {!data.hideDate && (
          <p class="text-sm font-semibold text-pink-700">
            <time datetime={data.date.toISOString()}>{parts.monthYear}</time>
          </p>
        )}
        <Heading class="h3 mt-2">{data.title}</Heading>
        <p class="meta mt-3 text-[0.9375rem] text-muted">
          <Icon name={virtual ? 'video' : 'pin'} size={18} />
          <span>{virtual ? 'Virtual' : data.location}</span>
          {data.partner && <span>, with {data.partner}</span>}
        </p>
        <div class="mt-5">
          <p class="text-sm font-bold">Recap</p>
          <div class="prose-gwc mt-2 max-w-[56ch]">{hasRecap ? <Content /> : <p>{data.description}</p>}</div>
        </div>
      </div>
      {data.image && (
        <div class="lg:col-span-7">
          <Image
            src={data.image}
            alt={data.imageAlt ?? ''}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 700px, 100vw"
            class="w-full rounded-[4px] border border-line"
          />
        </div>
      )}
    </article>
  )
}

<style>
  .date-tile {
    display: grid;
    place-items: center;
    align-content: center;
    width: 5rem;
    height: 5.5rem;
    border: 1px solid var(--color-line-strong);
    border-top: 4px solid var(--color-pink-600);
    border-radius: 4px;
    background: var(--color-white);
    line-height: 1;
  }
  .date-month {
    font-size: 0.8125rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-pink-700);
  }
  .date-day {
    margin-top: 0.3rem;
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .meta :global(svg) {
    flex: none;
    color: var(--color-pink-700);
  }
  .draft-tag {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.5rem;
    border: 1px dashed var(--color-pink-700);
    border-radius: 3px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-pink-700);
  }
</style>
