# Copy to .env for local builds, or set these in Netlify → Site configuration → Environment variables.

# Canonical site URL (sitemap, Open Graph). Netlify sets URL automatically; set this once a custom domain is live.
# SITE_URL=https://www.example.org

# Newsletter provider form endpoint. Leave unset to collect sign-ups with Netlify Forms instead.
# NEWSLETTER_FORM_ACTION=https://buttondown.com/api/emails/embed-subscribe/girlswhoconsult
# Name of the email field the provider expects: Buttondown "email", Mailchimp "EMAIL", Kit/ConvertKit "email_address".
# NEWSLETTER_EMAIL_FIELD=email
